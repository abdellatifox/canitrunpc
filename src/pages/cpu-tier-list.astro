---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getCpus } from '../lib/db';
import { releasedGames } from '../lib/games';
import { SITE_URL, SITE_NAME } from '../lib/site';
import { SEO_YEAR } from '../lib/year';
import { fitMeta } from '../lib/seo';

// Same table as /cpus and every /cpu page.
const cpus = await getCpus(Astro.locals);
const year = SEO_YEAR;

// Measured only against games that name a processor we can place.
const games = releasedGames().filter(g => g.rec_cpu_score != null);
const cov = new Map(cpus.map(c => [
  c.slug,
  Math.round((games.filter(g => c.score >= g.rec_cpu_score!).length / Math.max(1, games.length)) * 100)
]));

const ROLE: Record<string, string> = {
  S: 'no graphics card will outrun it',
  A: 'a match for flagship cards',
  B: 'a match for upper-mid-range cards',
  C: 'right for 1080p and 1440p builds',
  D: 'holds back fast cards in CPU-heavy games',
  F: 'under the six-core line most new games expect'
};

const tiers = ['S', 'A', 'B', 'C', 'D', 'F']
  .map(t => {
    const chips = cpus.filter(c => c.tier === t);
    const weakest = chips[chips.length - 1];
    const cores = chips.map(c => c.cores);
    return {
      tier: t, chips,
      lo: weakest?.score, hi: chips[0]?.score,
      floor: weakest ? cov.get(weakest.slug)! : 0,
      coreLo: Math.min(...cores), coreHi: Math.max(...cores),
      amd: chips.filter(c => c.brand === 'AMD').length,
      intel: chips.filter(c => c.brand === 'Intel').length
    };
  })
  .filter(t => t.chips.length > 0);

const fastest = cpus[0];
const amdBest = cpus.find(c => c.brand === 'AMD');
const intelBest = cpus.find(c => c.brand === 'Intel');
const leastCores = cpus.filter(c => cov.get(c.slug) === 100).sort((a, b) => a.cores - b.cores || a.score - b.score)[0];

const title = `CPU Tier List ${year}: ${cpus.length} Gaming Processors, S to F | ${SITE_NAME}`;
const description = fitMeta([
  `${cpus.length} gaming processors sorted into six tiers for ${year}, with cores, threads and the share of PC games each one meets at the recommended processor.`,
  'AMD and Intel side by side.'
]);

const faq = [
  {
    q: `Which processor is fastest for gaming in ${year}?`,
    a: `The ${fastest.name} (${fastest.cores} cores, ${fastest.threads} threads). It sets 100 on our gaming index.`
  },
  {
    q: 'Is AMD or Intel ahead right now?',
    a: amdBest && intelBest
      ? `AMD's best in our ranking is the ${amdBest.name} at ${amdBest.score}; Intel's is the ${intelBest.name} at ${intelBest.score}. ${tiers.filter(t => t.tier === 'S' || t.tier === 'A').map(t => `${t.tier} tier holds ${t.amd} AMD and ${t.intel} Intel chips`).join('; ')}.`
      : 'We track too few chips from one of the two makers to compare them fairly.'
  },
  {
    q: 'How many cores does a gaming PC need?',
    a: leastCores
      ? `Six is the floor most new releases are built around and eight gives headroom. The chip with the fewest cores that still meets every tracked game's recommended processor is the ${leastCores.name}, with ${leastCores.cores}.`
      : 'Six is the floor most new releases are built around and eight gives headroom.'
  },
  {
    q: 'When does the processor limit frame rate?',
    a: 'Mostly at 1080p, at high refresh rates, and in strategy, simulation and open-world games with many moving parts. At 4K the graphics card is usually the limit instead.'
  }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": `CPU Tier List ${year}`,
    "description": description,
    "url": `${SITE_URL}/cpu-tier-list`,
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": cpus.length,
      "itemListOrder": "https://schema.org/ItemListOrderDescending",
      "itemListElement": cpus.slice(0, 40).map((c, i) => ({ "@type": "ListItem", "position": i + 1, "url": `${SITE_URL}/cpu/${c.slug}`, "name": c.name }))
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }
];
---
<BaseLayout title={title} description={description} jsonLd={schema}
  keywords={`cpu tier list ${year}, best gaming cpu ${year}, processor ranking, cpu hierarchy, amd vs intel gaming`}>
  <div class="wrap">
    <Breadcrumbs items={[{ name: 'Processors', href: '/cpus' }, { name: `Tier list ${year}` }]} />

    <header class="head">
      <span class="eyebrow">Ranking · {cpus.length} processors · measured against {games.length} games</span>
      <h1>CPU Tier List {year}</h1>
      <p class="lede">
        Processors ranked on gaming work, not rendering or file compression. The percentage beside each chip is
        how many PC games list a recommended processor it matches or beats.
      </p>
    </header>

    <ol class="ladder" aria-label="Tiers at a glance">
      {tiers.map(t => (
        <li>
          <a href={`#tier-${t.tier}`}>
            <span class={`tb t-${t.tier}`}>{t.tier}</span>
            <span class="lad-body">
              <b>{ROLE[t.tier]}</b>
              <small class="mono">index {t.lo}–{t.hi} · {t.chips.length} chips</small>
            </span>
          </a>
        </li>
      ))}
    </ol>

    {tiers.map(t => (
      <section class="tier" id={`tier-${t.tier}`}>
        <div class="tier-top">
          <span class={`tb big t-${t.tier}`}>{t.tier}</span>
          <div>
            <h2>{t.tier} tier: {ROLE[t.tier]}</h2>
            <p>
              {t.coreLo === t.coreHi ? <>All {t.coreLo}-core.</> : <>{t.coreLo} to {t.coreHi} cores.</>}
              {' '}{t.amd} from AMD, {t.intel} from Intel. The slowest chip here still meets the recommended processor of <b>{t.floor}%</b> of games.
            </p>
          </div>
        </div>
        <ul class="rows">
          {t.chips.map(c => (
            <li>
              <a href={`/cpu/${c.slug}`} class="row">
                <span class="nm">{c.name}</span>
                <span class="bar" aria-hidden="true"><i style={`width:${c.score}%`}></i></span>
                <span class="mono idx">{c.score}</span>
                <span class="meta">{c.cores}C/{c.threads}T · {c.release_year}</span>
                <span class="mono cv" title="Share of games at recommended">{cov.get(c.slug)}%</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section class="faq">
      <h2>About this ranking</h2>
      {faq.map(f => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </section>

    <nav class="related" aria-label="Next steps">
      <h2>Keep going</h2>
      <ul>
        <li><a href="/gpu-tier-list">The {year} graphics card ranking</a></li>
        <li><a href="/bottleneck">Check a CPU and GPU pairing</a></li>
        <li><a href="/compare-cpu">Put two processors head to head</a></li>
        <li><a href="/game-list/cpu-intensive-games">Games that lean on the processor</a></li>
      </ul>
    </nav>
  </div>
</BaseLayout>

<style>
  .head { padding: 28px 0 26px; }
  .head h1 { font-size: clamp(30px, 5vw, 46px); margin: 6px 0 12px; }

  .ladder { list-style: none; padding: 0; margin: 0 0 48px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .ladder a { display: flex; gap: 12px; align-items: center; padding: 10px 12px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-sm); }
  .ladder a:hover { border-color: rgb(var(--accent-rgb) / .55); }
  .lad-body { display: flex; flex-direction: column; min-width: 0; }
  .lad-body b { font-size: 13.5px; line-height: 1.3; }
  .lad-body small { color: var(--faint); font-size: 11.5px; }

  .tb { width: 34px; height: 34px; flex: none; display: grid; place-items: center; font-family: var(--font-display); font-weight: 700; color: var(--tier-ink); clip-path: polygon(0 0, 100% 0, 100% 72%, 72% 100%, 0 100%); }
  .tb.big { width: 50px; height: 50px; font-size: 24px; }
  .t-S { background: var(--tier-S); } .t-A { background: var(--tier-A); } .t-B { background: var(--tier-B); }
  .t-C { background: var(--tier-C); } .t-D { background: var(--tier-D); } .t-F { background: var(--tier-F); }

  .tier { margin-bottom: 44px; scroll-margin-top: 80px; }
  .tier-top { display: flex; gap: 14px; align-items: flex-start; margin-bottom: 12px; }
  .tier-top h2 { font-size: 20px; margin-bottom: 4px; }
  .tier-top p { color: var(--muted); font-size: 14px; max-width: 72ch; }
  .tier-top b { color: var(--text); }

  .rows { list-style: none; padding: 0; margin: 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .rows li + li { border-top: 1px solid var(--line); }
  .row { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(60px, 1fr) 36px minmax(90px, .8fr) 44px; gap: 12px; align-items: center; padding: 9px 14px; background: var(--surface); font-size: 14px; }
  .row:hover { background: var(--surface-2); }
  .nm { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bar { height: 6px; background: var(--surface-2); border-radius: 3px; overflow: hidden; }
  .bar i { display: block; height: 100%; background: var(--readout); }
  .idx { color: var(--readout); text-align: right; }
  .meta { color: var(--faint); font-size: 12.5px; }
  .cv { text-align: right; color: var(--ok); }

  @media (max-width: 760px) {
    .ladder { grid-template-columns: 1fr 1fr; }
    .row { grid-template-columns: minmax(0, 1fr) 36px 44px; row-gap: 2px; }
    .bar { display: none; }
    .meta { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
