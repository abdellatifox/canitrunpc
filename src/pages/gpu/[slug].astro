---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import { getGpu, getGpus } from '../../lib/db';
import { releasedGames, upcomingGames } from '../../lib/games';
import { estimateFps } from '../../lib/perf';
import { SITE_URL, SITE_NAME } from '../../lib/site';
import { SEO_YEAR } from '../../lib/year';
import { fitTitle, fitMeta } from '../../lib/seo';
import hardwareForPaths from '../../lib/hardware-data.json';

export function getStaticPaths() {
  return (hardwareForPaths as { gpus: { slug: string }[] }).gpus.map(g => ({ params: { slug: g.slug } }));
}

const { slug } = Astro.params;
const gpu = await getGpu(Astro.locals, slug!);
if (!gpu) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const allGpus = await getGpus(Astro.locals);
const rank = allGpus.findIndex(g => g.slug === gpu.slug) + 1;
const slower = allGpus.filter(g => g.score < gpu.score).length;
const beatsPct = Math.round((slower / Math.max(1, allGpus.length - 1)) * 100);

/* Only games whose publisher named a card we could place. Comparing against a
   missing score is how the old page counted unmeasurable games as "runs at
   recommended": in JavaScript `27 >= null` is true. */
const measurable = (g: any) => g.min_gpu_score != null && g.rec_gpu_score != null;
const meetsRec = (g: any) => gpu.score >= g.rec_gpu_score && (g.rec_vram_gb == null || gpu.vram_gb >= g.rec_vram_gb);
const meetsMin = (g: any) => gpu.score >= g.min_gpu_score && (g.min_vram_gb == null || gpu.vram_gb >= g.min_vram_gb);

const released = releasedGames().filter(measurable);
const atRec = released.filter(meetsRec);
const atMin = released.filter(g => meetsMin(g) && !meetsRec(g));
const below = released.filter(g => !meetsMin(g));
const share = (n: number) => Math.round((n / Math.max(1, released.length)) * 100);

// Concrete edges of the coverage: the hardest game it still handles properly,
// and the lightest one it cannot start by the publisher's numbers.
const hardestAtRec = [...atRec].sort((a, b) => b.rec_gpu_score! - a.rec_gpu_score!)[0] ?? null;
const lightestBelow = [...below].sort((a, b) => a.min_gpu_score! - b.min_gpu_score!)[0] ?? null;

const upcoming = upcomingGames().filter(measurable);
const upRec = upcoming.filter(meetsRec);
const upMin = upcoming.filter(g => meetsMin(g) && !meetsRec(g));
const upBelow = upcoming.filter(g => !meetsMin(g));

// A processor quick enough not to cap this card, so the numbers are the GPU's.
const refCpuScore = Math.min(100, Math.round(gpu.score * 1.05));
const FPS_CEILING = 300;
const showFps = (v: number) => (v >= FPS_CEILING ? `${FPS_CEILING}+` : String(v));
const heavy = released
  .filter(g => g.rec_gpu_score! >= 40)
  .sort((a, b) => b.rec_gpu_score! - a.rec_gpu_score!)
  .slice(0, 8)
  .map(g => ({ game: g, fps: ['1080p', '1440p', '4k'].map(r => estimateFps(g, gpu.score, refCpuScore, r, 'high')) }));

const target =
  gpu.score >= 85 ? '4K with frame rate to spare'
  : gpu.score >= 68 ? '1440p at high refresh rates, or 4K with upscaling on'
  : gpu.score >= 48 ? '1440p around 60 FPS, or fast 1080p'
  : gpu.score >= 30 ? '1080p at 60 FPS on medium-to-high settings'
  : '1080p with settings turned down';

const upscalers = [gpu.supports_dlss && 'DLSS', gpu.supports_fsr && 'FSR', gpu.supports_xess && 'XeSS'].filter(Boolean) as string[];
const psu = Math.ceil((gpu.tdp_watts * 2 + 150) / 50) * 50;

// Nearest cards by score, one step either side where possible.
const above = allGpus.filter(g => g.score > gpu.score).sort((a, b) => a.score - b.score).slice(0, 3);
const beneath = allGpus.filter(g => g.score < gpu.score).sort((a, b) => b.score - a.score).slice(0, 3);
const neighbours = [...above.reverse(), ...beneath];

const title = fitTitle(gpu.name, [' — Benchmarks & FPS', ' Benchmarks & FPS', ' Benchmarks'], ` | ${SITE_NAME}`);
const description = fitMeta([
  `${gpu.name}: ${gpu.vram_gb} GB, ${gpu.tdp_watts} W, faster than ${beatsPct}% of the cards we track.`,
  `Meets the recommended spec of ${share(atRec.length)}% of PC games.`,
  upcoming.length ? `See which ${SEO_YEAR} releases it runs.` : 'See what it runs.'
]);

const faq: { q: string; a: string }[] = [
  {
    q: `Will the ${gpu.name} run ${SEO_YEAR} games?`,
    a: upcoming.length
      ? `Of the ${upcoming.length} upcoming games whose publishers have named a graphics card, it meets the recommended card for ${upRec.length}, only the minimum for ${upMin.length}, and falls short of ${upBelow.length}.`
      : `No upcoming game we track has named a graphics card yet, so there is nothing measurable to check it against.`
  },
  {
    q: `Is ${gpu.vram_gb} GB of VRAM enough?`,
    a: gpu.vram_gb >= 12 ? `Yes for 1440p, and for 4K in most games.`
      : gpu.vram_gb >= 8 ? `For 1080p and most 1440p games, yes. The heaviest recent releases will want textures turned down.`
      : `It is below what many recent releases expect, so plan on lower texture settings.`
  },
  {
    q: `What power supply do I need for the ${gpu.name}?`,
    a: `It is rated at ${gpu.tdp_watts} W. With the rest of a typical gaming PC and headroom for power spikes, a good ${psu} W unit is a safe choice; the PSU calculator works it out for your exact parts.`
  }
];
if (neighbours[0]) faq.push({
  q: `Is the ${gpu.name} faster than the ${neighbours[0].name}?`,
  a: neighbours[0].score > gpu.score
    ? `No. The ${neighbours[0].name} scores ${neighbours[0].score}/100 against ${gpu.score}/100 in our index.`
    : `Yes. It scores ${gpu.score}/100 against ${neighbours[0].score}/100 for the ${neighbours[0].name}.`
});

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": gpu.name,
    "url": `${SITE_URL}/gpu/${gpu.slug}`,
    "brand": { "@type": "Brand", "name": gpu.brand },
    "category": "Graphics Card",
    "description": description,
    "releaseDate": String(gpu.release_year),
    // No Offer: we do not sell cards, and a launch MSRP is not a current price.
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "VRAM", "value": `${gpu.vram_gb} GB` },
      { "@type": "PropertyValue", "name": "TDP", "value": `${gpu.tdp_watts} W` },
      { "@type": "PropertyValue", "name": "Performance index", "value": `${gpu.score}/100` },
      ...(gpu.msrp_usd ? [{ "@type": "PropertyValue", "name": "Launch MSRP", "value": `$${gpu.msrp_usd}` }] : [])
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }
];
---
<BaseLayout title={title} description={description} jsonLd={schema}
  keywords={`${gpu.name} benchmark, ${gpu.name} fps, ${gpu.name} games, is ${gpu.name} good ${SEO_YEAR}`}>
  <div class="wrap">
    <Breadcrumbs items={[{ name: 'Graphics cards', href: '/gpus' }, { name: gpu.name }]} />

    <header class="dossier">
      <span class="eyebrow">Graphics card · {gpu.brand} · {gpu.release_year}</span>
      <h1>{gpu.name}</h1>
      <p class="summary">
        Built for <b>{target}</b>. It outscores <b>{beatsPct}%</b> of the {allGpus.length} cards in our index
        and meets the recommended graphics card of <b>{atRec.length} of {released.length}</b> released games
        that name one.
      </p>
      <dl class="readouts">
        <div><dt>Index</dt><dd class="mono">{gpu.score}<small>/100</small></dd></div>
        <div><dt>Rank</dt><dd class="mono">#{rank}</dd></div>
        <div><dt>VRAM</dt><dd class="mono">{gpu.vram_gb} GB</dd></div>
        <div><dt>Power</dt><dd class="mono">{gpu.tdp_watts} W</dd></div>
        <div><dt>Launch price</dt><dd class="mono">{gpu.msrp_usd ? `$${gpu.msrp_usd}` : '—'}</dd></div>
      </dl>
    </header>

    {/* ============ COVERAGE ============ */}
    <section class="block">
      <div class="block-head">
        <h2>How much of the PC library it covers</h2>
        <p>Against the {released.length} released games whose publisher names a graphics card we can place.</p>
      </div>
      <div class="coverage" role="img" aria-label={`${share(atRec.length)}% at recommended, ${share(atMin.length)}% at minimum, ${share(below.length)}% below minimum`}>
        <span class="seg ok" style={`flex:${atRec.length || 0.0001}`}></span>
        <span class="seg warn" style={`flex:${atMin.length || 0.0001}`}></span>
        <span class="seg bad" style={`flex:${below.length || 0.0001}`}></span>
      </div>
      <ul class="legend">
        <li><i class="ok"></i><b class="mono">{atRec.length}</b> at the recommended spec <span>{share(atRec.length)}%</span></li>
        <li><i class="warn"></i><b class="mono">{atMin.length}</b> at the minimum only <span>{share(atMin.length)}%</span></li>
        <li><i class="bad"></i><b class="mono">{below.length}</b> below the minimum <span>{share(below.length)}%</span></li>
      </ul>
      {(hardestAtRec || lightestBelow) && (
        <p class="edges">
          {hardestAtRec && <>The most demanding game it meets the recommended card for is <a href={`/game/${hardestAtRec.slug}`}>{hardestAtRec.name}</a>. </>}
          {lightestBelow && <>The least demanding one it falls short of is <a href={`/game/${lightestBelow.slug}`}>{lightestBelow.name}</a>.</>}
        </p>
      )}
    </section>

    {/* ============ UPCOMING ============ */}
    {upcoming.length > 0 && (
      <section class="block">
        <div class="block-head">
          <h2>Upcoming releases on the {gpu.name}</h2>
          <p>Unreleased games whose publishers have already posted a graphics card requirement.</p>
        </div>
        <div class="up-grid">
          {[
            { key: 'ok', label: 'Recommended spec', list: upRec },
            { key: 'warn', label: 'Minimum spec', list: upMin },
            { key: 'bad', label: 'Below minimum', list: upBelow }
          ].map(col => (
            <div class={`up-col ${col.key}`}>
              <h3>{col.label} <span class="mono">{col.list.length}</span></h3>
              {col.list.length
                ? <ul>{col.list.map(g => <li><a href={`/game/${g.slug}`}>{g.name}</a> <small>{g.release_date}</small></li>)}</ul>
                : <p class="none">None</p>}
            </div>
          ))}
        </div>
      </section>
    )}

    {/* ============ FPS ============ */}
    {heavy.length > 0 && (
      <section class="block">
        <div class="block-head">
          <h2>In the heaviest games we track</h2>
          <p>Modelled at the High preset with upscaling off, next to a processor fast enough not to limit it. Estimates, not recorded runs — <a href="/editorial-standards">how the model works</a>.</p>
        </div>
        <div class="table-scroll">
          <table class="data-table">
            <thead><tr><th>Game</th><th>1080p</th><th>1440p</th><th>4K</th></tr></thead>
            <tbody>
              {heavy.map(r => (
                <tr>
                  <td><a href={`/can-it-run/${r.game.slug}/${gpu.slug}`}>{r.game.name}</a></td>
                  {r.fps.map(v => <td class="fps mono" data-v={v}>{showFps(v)}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {/* ============ SPEC GRID ============ */}
    <section class="block">
      <div class="block-head"><h2>Spec card</h2></div>
      <dl class="spec-grid">
        <div><dt>Maker</dt><dd>{gpu.brand}</dd></div>
        <div><dt>Released</dt><dd>{gpu.release_year}</dd></div>
        <div><dt>Video memory</dt><dd>{gpu.vram_gb} GB</dd></div>
        <div><dt>Rated power</dt><dd>{gpu.tdp_watts} W</dd></div>
        <div><dt>PSU to plan for</dt><dd>{psu} W</dd></div>
        <div><dt>Tier</dt><dd><span class={`pill t-${gpu.tier}`}>{gpu.tier}</span></dd></div>
        <div><dt>Ray tracing</dt><dd>{gpu.supports_ray_tracing ? 'Yes' : 'No'}</dd></div>
        <div><dt>Upscaling</dt><dd>{upscalers.join(' · ') || 'None'}</dd></div>
      </dl>
    </section>

    {/* ============ NEIGHBOURS ============ */}
    {neighbours.length > 0 && (
      <section class="block">
        <div class="block-head">
          <h2>The cards either side of it</h2>
          <p>Nearest in our index. Pick one to put them side by side.</p>
        </div>
        <ul class="near">
          {neighbours.map(n => {
            const d = n.score - gpu.score;
            return (
              <li>
                <a href={`/compare-gpu?a=${gpu.slug}&b=${n.slug}`}>
                  <span class={`delta mono ${d > 0 ? 'up' : 'down'}`}>{d > 0 ? `+${d}` : d}</span>
                  <span class="near-name">{n.name}</span>
                  <small>{n.vram_gb} GB{n.msrp_usd ? ` · $${n.msrp_usd}` : ''}</small>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <section class="faq">
      <h2>{gpu.name}: quick answers</h2>
      {faq.map(f => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </section>

    <nav class="related" aria-label="Next steps">
      <h2>Keep going</h2>
      <ul>
        <li><a href="/can-it-run">Test a game on this card</a></li>
        <li><a href="/gpu-tier-list">Where it sits in the {SEO_YEAR} tier list</a></li>
        <li><a href="/bottleneck">Pair it with the right CPU</a></li>
        <li><a href="/psu-calculator">Size your power supply</a></li>
        <li><a href={`/upcoming-games-${SEO_YEAR}`}>{SEO_YEAR} releases</a></li>
      </ul>
    </nav>
  </div>
</BaseLayout>

<style>
  .dossier { padding: 30px 0 32px; margin-bottom: 40px; border-bottom: 1px dashed var(--line-strong); }
  .dossier h1 { font-size: clamp(28px, 4.5vw, 44px); margin: 6px 0 12px; }
  .summary { color: var(--muted); max-width: 66ch; line-height: 1.7; }
  .summary b { color: var(--text); }
  .readouts {
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); margin: 20px 0 0;
    border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface);
  }
  .readouts div { padding: 11px 14px; min-width: 0; }
  .readouts div + div { border-left: 1px solid var(--line); }
  .readouts dt { font-family: var(--font-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--faint); }
  .readouts dd { margin: 3px 0 0; font-size: 1.35rem; font-weight: 600; color: var(--readout); }
  .readouts small { font-size: .8rem; color: var(--faint); }

  .block { margin-bottom: 46px; padding: 0; }
  .block-head { margin-bottom: 16px; }
  .block-head h2 { font-size: 22px; }
  .block-head p { color: var(--muted); font-size: 14.5px; margin-top: 6px; max-width: 72ch; }
  .block-head a, .edges a { color: var(--accent); }

  .coverage { display: flex; height: 14px; border-radius: 3px; overflow: hidden; background: var(--surface-2); gap: 2px; }
  .seg.ok { background: var(--ok); } .seg.warn { background: var(--warn); } .seg.bad { background: var(--bad); }
  .legend { list-style: none; padding: 0; margin: 12px 0 0; display: flex; gap: 8px 22px; flex-wrap: wrap; }
  .legend li { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 14px; }
  .legend i { width: 10px; height: 10px; display: inline-block; border-radius: 2px; }
  .legend i.ok { background: var(--ok); } .legend i.warn { background: var(--warn); } .legend i.bad { background: var(--bad); }
  .legend b { color: var(--text); }
  .legend span { color: var(--faint); font-family: var(--font-mono); font-size: 12px; }
  .edges { color: var(--muted); font-size: 14.5px; margin-top: 12px; }

  .up-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .up-col { background: var(--surface); border: 1px solid var(--line); border-top: 3px solid; border-radius: var(--radius-sm); padding: 12px 14px; }
  .up-col.ok { border-top-color: var(--ok); } .up-col.warn { border-top-color: var(--warn); } .up-col.bad { border-top-color: var(--bad); }
  .up-col h3 { font-size: 14px; display: flex; justify-content: space-between; margin-bottom: 8px; }
  .up-col ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .up-col li { font-size: 14px; line-height: 1.35; }
  .up-col li a:hover { color: var(--accent); }
  .up-col small { display: block; color: var(--faint); font-size: 12px; }
  .none { color: var(--faint); font-size: 13px; }

  .fps { font-weight: 600; }

  .spec-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; margin: 0; }
  .spec-grid div { background: var(--surface); padding: 12px 14px; }
  .spec-grid dt { font-size: 12px; color: var(--faint); }
  .spec-grid dd { margin: 2px 0 0; font-weight: 700; }

  .near { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 8px; }
  .near a { display: grid; grid-template-columns: 48px 1fr; grid-template-rows: auto auto; column-gap: 10px; padding: 11px 14px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-sm); }
  .near a:hover { border-color: rgb(var(--accent-rgb) / .55); }
  .delta { grid-row: 1 / 3; align-self: center; font-weight: 600; }
  .delta.up { color: var(--ok); } .delta.down { color: var(--bad); }
  .near-name { font-weight: 700; font-size: 14px; }
  .near small { color: var(--faint); font-size: 12px; }

  @media (max-width: 760px) {
    .readouts { grid-template-columns: 1fr 1fr; }
    .readouts div:nth-child(odd) { border-left: 0; }
    .readouts div:nth-child(n+3) { border-top: 1px solid var(--line); }
    .up-grid { grid-template-columns: 1fr; }
    .spec-grid { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.fps').forEach(el => {
    const v = parseInt(el.dataset.v || '0', 10);
    el.style.color = v >= 90 ? 'var(--ok)' : v >= 60 ? 'var(--readout)' : v >= 30 ? 'var(--warn)' : 'var(--bad)';
  });
</script>
