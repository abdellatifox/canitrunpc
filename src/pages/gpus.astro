---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getGpus } from '../lib/db';
import { releasedGames } from '../lib/games';
import { SITE_URL, SITE_NAME } from '../lib/site';
import { SEO_YEAR } from '../lib/year';
import { fitMeta } from '../lib/seo';

const gpus = await getGpus(Astro.locals);
const makers = [...new Set(gpus.map(g => g.brand))].sort();
const laptops = gpus.filter(g => /laptop/i.test(g.name)).length;
const newest = Math.max(...gpus.map(g => g.release_year));
const mostVram = [...gpus].sort((a, b) => b.vram_gb - a.vram_gb || b.score - a.score)[0];

// Share of released games (with a measurable GPU requirement) each card meets at recommended.
const games = releasedGames().filter(g => g.rec_gpu_score != null);
const coverage = (g: typeof gpus[number]) =>
  Math.round((games.filter(x => g.score >= x.rec_gpu_score! && (x.rec_vram_gb == null || g.vram_gb >= x.rec_vram_gb)).length / Math.max(1, games.length)) * 100);

const description = fitMeta([
  `Look up any of ${gpus.length} desktop and laptop graphics cards: release year, memory, power, performance index and how many PC games it meets at recommended settings.`,
  'Filter by maker or memory.'
]);

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Graphics card database",
  "description": description,
  "url": `${SITE_URL}/gpus`,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": gpus.length,
    "itemListElement": gpus.slice(0, 40).map((g, i) => ({ "@type": "ListItem", "position": i + 1, "url": `${SITE_URL}/gpu/${g.slug}`, "name": g.name }))
  }
};
---
<BaseLayout title={`Graphics Card Database: ${gpus.length} GPUs Compared | ${SITE_NAME}`} description={description}
  keywords="graphics card database, gpu list, gpu specs, gpu vram list, gpu performance ranking" jsonLd={schema}>
  <div class="wrap">
    <Breadcrumbs items={[{ name: 'Graphics cards' }]} />

    <header class="head">
      <span class="eyebrow">Database</span>
      <h1>Graphics card database</h1>
      <p class="lede">
        One row per card, fastest first. The last column shows how many games list a recommended graphics card
        this one matches — the quickest way to judge a card you are thinking of buying, or the one already in your PC.
      </p>
      <dl class="readouts">
        <div><dt>Cards</dt><dd class="mono">{gpus.length}</dd></div>
        <div><dt>Laptop chips</dt><dd class="mono">{laptops}</dd></div>
        <div><dt>Newest</dt><dd class="mono">{newest}</dd></div>
        <div><dt>Most memory</dt><dd class="mono">{mostVram.vram_gb} GB</dd></div>
      </dl>
    </header>

    <div class="filters">
      <input type="search" id="q" placeholder="Type a model, e.g. 4070" aria-label="Find a graphics card">
      <select id="maker" aria-label="Maker">
        <option value="">Every maker</option>
        {makers.map(m => <option value={m}>{m}</option>)}
      </select>
      <select id="mem" aria-label="Minimum memory">
        <option value="0">Any memory</option>
        <option value="8">8 GB or more</option>
        <option value="12">12 GB or more</option>
        <option value="16">16 GB or more</option>
      </select>
      <label class="tog"><input type="checkbox" id="desk"> Desktop only</label>
    </div>
    <p class="count mono" id="count" aria-live="polite">{gpus.length} cards</p>

    <div class="table-scroll">
      <table class="data-table" id="list">
        <thead><tr><th>Card</th><th>Released</th><th>Memory</th><th>Power</th><th>Index</th><th>Games at recommended</th></tr></thead>
        <tbody>
          {gpus.map(g => {
            const c = coverage(g);
            return (
              <tr data-maker={g.brand} data-name={g.name.toLowerCase()} data-mem={g.vram_gb} data-laptop={/laptop/i.test(g.name) ? '1' : ''}>
                <td><a href={`/gpu/${g.slug}`}>{g.name}</a></td>
                <td class="mono">{g.release_year}</td>
                <td class="mono">{g.vram_gb} GB</td>
                <td class="mono">{g.tdp_watts} W</td>
                <td><span class="idx"><span class="trk"><i style={`width:${g.score}%`}></i></span><b class="mono">{g.score}</b></span></td>
                <td class="mono cov">{c}%</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <nav class="related" aria-label="Next steps">
      <h2>Keep going</h2>
      <ul>
        <li><a href="/gpu-tier-list">Cards grouped into tiers for {SEO_YEAR}</a></li>
        <li><a href="/compare-gpu">Put two cards head to head</a></li>
        <li><a href="/ray-tracing">Which cards handle ray tracing</a></li>
        <li><a href="/cpus">The processor database</a></li>
      </ul>
    </nav>
  </div>
</BaseLayout>

<style>
  .head { padding: 28px 0 22px; }
  .head h1 { font-size: clamp(30px, 5vw, 44px); margin: 6px 0 12px; }
  .readouts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 20px 0 0; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .readouts div { padding: 10px 14px; }
  .readouts div + div { border-left: 1px solid var(--line); }
  .readouts dt { font-family: var(--font-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--faint); }
  .readouts dd { margin: 3px 0 0; font-size: 1.25rem; font-weight: 600; color: var(--readout); }

  .filters { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 8px 0 8px; }
  .filters input[type=search], .filters select { background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--radius-sm); padding: 10px 12px; color: var(--text); font: inherit; min-height: 44px; }
  .filters input[type=search] { flex: 1 1 220px; }
  .filters input:focus, .filters select:focus { border-color: var(--accent); outline: none; }
  .tog { display: flex; gap: 8px; align-items: center; color: var(--muted); font-size: 14px; min-height: 44px; }
  .count { color: var(--faint); font-size: 12.5px; margin-bottom: 12px; }

  .idx { display: inline-flex; align-items: center; gap: 8px; }
  .trk { display: block; width: 60px; height: 5px; background: var(--surface-2); border-radius: 3px; overflow: hidden; }
  .trk i { display: block; height: 100%; background: var(--readout); }
  .idx b { color: var(--readout); }
  .cov { color: var(--ok); }

  @media (max-width: 760px) {
    .readouts { grid-template-columns: 1fr 1fr; }
    .readouts div:nth-child(3) { border-left: 0; }
    .readouts div:nth-child(n+3) { border-top: 1px solid var(--line); }
  }
</style>

<script>
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('#list tbody tr')];
  const q = document.getElementById('q') as HTMLInputElement;
  const maker = document.getElementById('maker') as HTMLSelectElement;
  const mem = document.getElementById('mem') as HTMLSelectElement;
  const desk = document.getElementById('desk') as HTMLInputElement;
  const count = document.getElementById('count')!;

  function apply() {
    const term = q.value.trim().toLowerCase();
    const min = Number(mem.value);
    let shown = 0;
    for (const r of rows) {
      const ok = (!term || (r.dataset.name || '').includes(term))
        && (!maker.value || r.dataset.maker === maker.value)
        && Number(r.dataset.mem) >= min
        && (!desk.checked || !r.dataset.laptop);
      r.hidden = !ok;
      if (ok) shown++;
    }
    count.textContent = `${shown} ${shown === 1 ? 'card' : 'cards'}`;
  }
  [q, maker, mem, desk].forEach(el => el.addEventListener('input', apply));
</script>
