---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getPosts } from '../../lib/db';
import { getPostCover } from '../../lib/images';
import { SITE_URL, SITE_NAME } from '../../lib/site';
import { SEO_YEAR } from '../../lib/year';

const posts = await getPosts(Astro.locals);
const categories = [...new Set(posts.map(p => p.category).filter(Boolean))].sort();

const description = `GPU head-to-heads, VRAM and RAM guides, and ${SEO_YEAR} PC game requirements, ${posts.length} articles built from publisher specs rather than guesswork.`;

const schema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": `${SITE_NAME} Blog`,
  "description": description,
  "url": `${SITE_URL}/blog`,
  "publisher": { "@id": `${SITE_URL}/#organization` },
  "blogPost": posts.slice(0, 20).map(p => ({
    "@type": "BlogPosting",
    "headline": p.title,
    "url": `${SITE_URL}/blog/${p.slug}`,
    "datePublished": p.published_at,
    "articleSection": p.category,
    "author": { "@type": "Organization", "name": p.author || `${SITE_NAME} Team` }
  }))
};
---
<BaseLayout
  title={`PC Gaming Guides & Hardware Blog | ${SITE_NAME}`}
  description={description}
  keywords="pc gaming blog, hardware guides, optimization tips, gpu guides, fps guides"
  jsonLd={schema}
  noindex={posts.length === 0}
>
  <main>
    <div class="wrap">  <Breadcrumbs items={[{ name: 'Blog' }]} />
</div>
    <section class="page-header">
      <h1>PC Gaming <span class="g">Guides & News</span></h1>
      <p class="lead">Optimization tips, hardware reviews, and gaming news.</p>
    </section>

    {posts.length === 0 && <p class="feed-note">No articles yet — the first guides are being written.</p>}

    <div class="category-tabs" hidden={posts.length === 0} role="group" aria-label="Filter by category">
      <button class="tab active" data-cat="">All</button>
      {categories.map(c => <button class="tab" data-cat={c}>{c}</button>)}
    </div>

    <div class="blog-grid">
      {posts.map((post, i) => (
        <a href={`/blog/${post.slug}`} class="blog-card" data-cat={post.category}>
          <div class="blog-img-wrap">
            <img
              src={getPostCover(post.slug).thumb}
              alt=""
              class="blog-img"
              width="1200"
              height="420"
              loading={i < 3 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>
          <div class="blog-info">
            <span class="badge">{post.category}</span>
            <h4>{post.title}</h4>
            {post.excerpt && <p class="excerpt">{post.excerpt}</p>}
            <span class="read-time">
              {typeof post.read_time === 'number' ? `${post.read_time} min read` : post.read_time}
            </span>
          </div>
        </a>
      ))}
    </div>

    <p class="feed-note">
      Subscribe via <a href="/rss.xml">RSS</a>, or jump to the
      <a href="/tools">tools</a> these guides refer to.
    </p>
  </main>
</BaseLayout>

<style>
  main { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; }
  .page-header { text-align: center; margin-bottom: 3rem; }
  .g { color: var(--accent); }
  .lead { font-size: 1.1rem; color: var(--muted); }
  
  .category-tabs { display: flex; gap: 1rem; justify-content: center; margin-bottom: 3rem; flex-wrap: wrap; }
  .tab { padding: 0.5rem 1rem; border-radius: var(--radius); background: var(--surface-2); color: var(--text); text-decoration: none; border: 1px solid var(--line); }
  .tab.active, .tab:hover { background: var(--accent); color: var(--bg); border-color: var(--accent); }
  
  .blog-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem; margin-bottom: 3rem; }
  .blog-card { background: var(--surface-2); border-radius: var(--radius); overflow: hidden; text-decoration: none; color: var(--text); transition: 0.3s; border: 1px solid transparent; display: flex; flex-direction: column; }
  .blog-card:hover { transform: translateY(-5px); border-color: var(--accent); }
  .blog-img-wrap { width: 100%; aspect-ratio: 16 / 9; overflow: hidden; background: var(--surface); }

  /* The banner is decoration and the headline sits directly under it, so on a
     phone it becomes a strip. At 16/9 it took 192px of a 441px card and pushed
     the title and read time off screen. This has to live in the page's own
     scoped block — a global rule loses to the scoped selector's specificity. */
  @media (max-width: 640px) {
    .blog-img-wrap { aspect-ratio: 24 / 7; }
  }
  .blog-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }
  .blog-card:hover .blog-img { transform: scale(1.05); }
  .blog-info { padding: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; }
  .blog-info h4 { margin: 1rem 0; font-size: 1.25rem; line-height: 1.4; }
  .badge { background: rgb(var(--accent-rgb) / 0.1); color: var(--accent); padding: 0.3rem 0.6rem; border-radius: 4px; font-size: 0.8rem; align-self: flex-start; }
  .read-time { color: var(--muted); font-size: 0.85rem; margin-top: auto; }
  
  .pagination { display: flex; justify-content: center; gap: 1rem; }
  .btn-ghost { background: transparent; color: var(--text); border: 1px solid var(--line-strong); padding: 0.5rem 1rem; border-radius: 6px; cursor: pointer; }
  .btn-ghost:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
  const cards = document.querySelectorAll<HTMLElement>('.blog-card');
  tabs.forEach(t => t.addEventListener('click', () => {
    tabs.forEach(x => x.classList.remove('active'));
    t.classList.add('active');
    const cat = t.dataset.cat || '';
    cards.forEach(c => { c.hidden = Boolean(cat) && c.dataset.cat !== cat; });
  }));
</script>

<style>
  .category-tabs .tab {
    background: transparent;
    border: 1px solid var(--line-strong);
    color: var(--muted);
    padding: 7px 16px;
    border-radius: 3px;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: all .2s var(--ease);
  }
  .category-tabs .tab:hover { color: var(--text); }
  .category-tabs .tab.active { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 600; }
  .blog-card .excerpt {
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.55;
    margin: 8px 0 10px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .feed-note { color: var(--muted); text-align: center; margin: 32px 0 60px; font-size: 14px; }
  .feed-note a { color: var(--accent); }
</style>
