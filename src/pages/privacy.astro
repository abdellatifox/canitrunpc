---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_URL, SITE_NAME, CONTACT_EMAIL, GTM_ID } from '../lib/site';

const updated = '2026-09-15';
// The page describes whichever build is live: with or without Google Tag Manager.
const measured = Boolean(GTM_ID);
---
<BaseLayout
  title={`Privacy Policy | ${SITE_NAME}`}
  description={measured
    ? `${SITE_NAME} has no accounts or ad trackers and measures visits with Google Tag Manager. What happens to the specs you enter, and how to reach us.`
    : `${SITE_NAME} has no accounts, no analytics and no advertising trackers. What happens to the specs you enter, what our hosting provider logs, and how to reach us.`}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Privacy policy",
    "url": `${SITE_URL}/privacy`,
    "dateModified": updated
  }}
>
  <div class="wrap">
    <Breadcrumbs items={[{ name: 'Privacy' }]} />

    <header class="head">
      <span class="eyebrow">Privacy · updated 15 September 2026</span>
      <h1>Privacy policy</h1>
      <p class="lede">{measured
        ? 'Short version: no accounts and no ad trackers; visits are measured through Google Tag Manager; the specs you type are not kept.'
        : 'Short version: no accounts, no analytics, no ad trackers, and the specs you type are not kept.'}</p>
    </header>

    <div class="prose">
      <h2>Parts you enter into the tools</h2>
      <p>
        Some tools work entirely in your browser. Others — Can I Run It?, the FPS calculator and the search boxes — send your
        choices (a game, a graphics card, a processor, a memory size) to our server to work out the answer. The answer is sent
        back and the choices are not saved or tied to you.
      </p>
      <p>
        When you look up a game we don’t already hold, its requirements are fetched from Steam and stored for up to 30 days so
        the next person gets them faster. That stored copy is about the game, not about you.
      </p>

      <h2>Cookies and tracking</h2>
      {measured ? (
        <>
          <p>
            We use Google Tag Manager to load Google’s measurement tools, such as Google Analytics. If you accept, they may set cookies and
            collect details like the pages you visit, how long you stay, your approximate location, device and browser, so we can
            see which pages and tools are used. We don’t use this for advertising and don’t sell it. Google processes the data
            under <a href="https://policies.google.com/privacy" rel="nofollow noopener" target="_blank">its own privacy policy</a>.
          </p>
          <p>
            <strong>Nothing is measured with cookies until you say yes.</strong> On your first visit a banner asks; until you
            accept, Google’s tags run in their cookieless mode. Your answer is remembered in your browser, and you can change it
            at any time from <em>Cookie settings</em> at the bottom of every page. The site works the same either way.
          </p>
          <p>
            You can also block cookies in your browser settings, or install Google’s
            <a href="https://tools.google.com/dlpage/gaoptout" rel="nofollow noopener" target="_blank">Analytics opt-out add-on</a>.
            Our own fonts and images are served from this domain.
          </p>
        </>
      ) : (
        <p>
          The site sets no cookies of its own and runs no analytics or advertising scripts. Fonts and images are served from this
          domain, so loading a page doesn’t call Google Fonts or any other third party.
        </p>
      )}

      <h2>Hosting</h2>
      <p>
        The site runs on Cloudflare. Like any web host, Cloudflare processes technical request data — IP address, browser and
        the address requested — to deliver pages and protect the site from abuse, and may set a strictly necessary security
        cookie to do so. Its handling is covered by Cloudflare’s own privacy policy.
      </p>

      <h2>Email</h2>
      <p>
        If you write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>, we keep the message only as long as needed to
        reply and act on it, and we don’t share it.
      </p>

      <h2>Children</h2>
      <p>{measured ? 'The site is not aimed at children and asks no one to enter personal information.' : 'The site collects no personal information from anyone, including children.'}</p>

      <h2>Changes and questions</h2>
      <p>
        If this policy changes, the date at the top changes with it. For any privacy question, email
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .head { padding: 28px 0 18px; }
  .head h1 { font-size: clamp(30px, 5vw, 44px); margin: 6px 0 12px; }
</style>
