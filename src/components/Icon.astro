---
/**
 * Draws one icon from the inline sprite.
 *
 * Replaces `<i class="bi bi-x">`, which needed the Bootstrap Icons webfont —
 * a third-party request that also left a blank box until the font arrived.
 * The sprite is inlined once per page by IconSprite, so this costs nothing
 * beyond a few bytes of markup.
 */
interface Props {
  /** Icon name, with or without the `bi-` prefix. */
  name: string;
  class?: string;
  /** Supply only when the icon carries meaning no nearby text already gives. */
  label?: string;
  title?: string;
}

const { name, class: className = '', label, title } = Astro.props;
const id = `i-${String(name).replace(/^bi-/, '')}`;
---
<svg
  class={`icon ${className}`.trim()}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}
  <use href={`#${id}`} />
</svg>

<style is:global>
  /* Sized in em so an icon always matches the text it sits beside, exactly as
     the font-based icons did. */
  .icon {
    width: 1em;
    height: 1em;
    display: inline-block;
    vertical-align: -0.125em;
    fill: currentColor;
    flex: none;
  }
</style>
